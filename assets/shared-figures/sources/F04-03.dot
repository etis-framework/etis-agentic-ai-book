// Logical editable DOT reference. Precise print master: F04-03.svg
// publishing/scripts/figures.py correctly prefers SVG master when present.
digraph F0403 {graph[label="Refund case: proposal is not payment permission",rankdir=LR];node[shape=box,style="rounded,filled",fontname="Arial",fontsize=23];subgraph cluster_agent {label="BOUNDED AGENT";evidence[label="Read scoped case evidence",fillcolor="#dcecf3"];proposal[label="Typed eligibility proposal only",fillcolor="#eef4f6"];evidence->proposal;}subgraph cluster_control {label="INDEPENDENT ENTERPRISE CONTROL";review[label="Policy and approval gate",fillcolor="#fff0ce"];hold[label="Deny or uncertain: hold and escalate",fillcolor="#eef4f6"];review->hold[label="DENY"]; }subgraph cluster_effect {label="TRUSTED FINANCIAL EFFECT";dispatch[label="Trusted dispatch with stable operation ID",fillcolor="#fff0ce"];confirmed[label="Confirmed with provider proof",fillcolor="#e7f2e4"];dispatch->confirmed;}proposal->review[style=dashed];review->dispatch[label="PERMIT"]; }
