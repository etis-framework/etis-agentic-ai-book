// Logical editable DOT reference. Precise print master: F04-02.svg
// publishing/scripts/figures.py correctly prefers SVG master when present.
digraph F0402 { graph [label="Three alternatives; not sequential stages",rankdir=LR]; node[shape=box,style="rounded,filled",fontname="Arial",fontsize=23]; subgraph cluster_A {label="FIXED WORKFLOW"; a1[label="Known inputs"];a2[label="Fixed sequence"];a3[label="Rule result"];a1->a2->a3;} subgraph cluster_B {label="BOUNDED AGENT";b1[label="Scoped goal"];b2[label="Choose next read"];b3[label="Observe and decide"];b1->b2->b3;b3->b2;} subgraph cluster_C {label="HYBRID WORKFLOW";c1[label="Durable workflow"];c2[label="Bounded agent read"];c3[label="Independent policy and review",fillcolor="#fff0ce"];c1->c2->c3;} }
