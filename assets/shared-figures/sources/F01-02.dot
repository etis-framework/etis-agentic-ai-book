digraph G {graph [rankdir=TB,bgcolor=white,pad="0.3",nodesep=.25,ranksep=.35,fontname="Helvetica",label="All paths retain independent authorization and payment control",labelloc=b,fontsize=14];node [shape=box,style="rounded,filled",fillcolor="#edf3f8",color="#56718b",fontname="Helvetica",fontsize=12];edge [color="#637f97",arrowsize=.7]; customer [label="Customer refund request",fillcolor="#e5f2e4"]; {rank=same; a [label="Deterministic workflow\nExplicit eligibility rules"];b [label="AI-assisted workflow\nModel summarizes; human decides"];c [label="Bounded agentic workflow\nAgent chooses permitted investigation steps\nand proposes remedy"]; } guard [label="Independent policy + authority checks\nDurable operation identity",fillcolor="#f8edcf",penwidth=2]; provider [label="Payment adapter + provider\nConfirm effect or reconcile UNKNOWN"];customer->a;customer->b;customer->c;a->guard;b->guard;c->guard;guard->provider;}
