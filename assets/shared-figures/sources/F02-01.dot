digraph G {graph [rankdir=LR,bgcolor=white,pad="0.3",nodesep=.28,ranksep=.45,fontname="Helvetica",label="A timeout does not prove failure; do not create a new refund identity",labelloc=b,fontsize=13];node [shape=box,style="rounded,filled",fontname="Helvetica",fontsize=12,color="#56718b",fillcolor="#edf3f8"];edge [color="#637f97",fontsize=11,arrowsize=.7];intent [label="1 · Durable intent\noperation_id = R-123"];send [label="2 · Send refund R-123\nthrough adapter"];paid [label="3 · Provider issues $500\nexternal effect committed",fillcolor="#e5f2e4"];lost [label="4 · Acknowledgment lost\nrequester times out",fillcolor="#f8edcf"];unknown [label="5 · Mark UNKNOWN\nnot FAILED",fillcolor="#f8edcf"];recon [label="6 · Query / reconcile R-123\nconfirm outcome before retry"];intent->send->paid->lost->unknown->recon;}
