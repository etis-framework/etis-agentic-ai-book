digraph G { graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.42", ranksep="0.72", fontname="Helvetica", label="Engineering foundations converge; they are not superseded", labelloc=b, fontsize=14]; node [shape=box, style="rounded,filled", fillcolor="#edf3f8", color="#56718b", fontname="Helvetica", fontsize=13, margin="0.19,0.13"]; edge [color="#637f97", penwidth=1.5, arrowsize=.75]; {rank=same; a [label="Transactions & records\nIntegrity · recovery"]; b [label="Expert systems & planning\nKnowledge · inference"]; c [label="Workflow & BPM\nOwnership · approvals"]; d [label="Distributed systems & APIs\nContracts · retries"]; e [label="Security & governance\nAuthority · evidence"]; } mid [label="Enterprise engineering\nTrusted systems and controls", fillcolor="#d7e6f3"]; ai [label="Modern AI capabilities\nLanguage · adaptive planning", fillcolor="#e5f2e4"]; result [label="Bounded agentic system\nReasoning + enforced controls", fillcolor="#f8edcf", penwidth=2]; a->mid;b->mid;c->mid;d->mid;e->mid;mid->result;ai->result; }
